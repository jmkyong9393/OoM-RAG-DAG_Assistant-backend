# ── Postgres (로컬 compose) ───────────────────────────────────────────────
POSTGRES_DB=oom
POSTGRES_USER=oom
POSTGRES_PASSWORD=oom
POSTGRES_PORT=15432

# ── Flyway placeholder (V2__roles.sql) ───────────────────────────────────
OOM_API_PASSWORD=oom_api
OOM_AI_PASSWORD=oom_ai

# ── api (Spring) ─────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:15432/oom
DB_USER=oom            # 운영: oom_api
DB_PASSWORD=oom
FLYWAY_USER=oom        # 스키마 소유자(관리자)
FLYWAY_PASSWORD=oom
AI_BASE_URL=http://localhost:18000
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=change-me
PORT=18080            # 8080은 다른 프로젝트가 쓰는 경우가 많아 기본을 18080으로

# ── ai (Python) — 키는 여기만 ────────────────────────────────────────────
AI_DB_URL=postgresql://oom_ai:oom_ai@localhost:15432/oom
AI_MODE=auto           # dummy | fake | openai | auto(키 있으면 openai, 없으면 fake)
LLM_PROFILE_DEFAULT_BASE_URL=https://api.openai.com/v1
LLM_PROFILE_DEFAULT_API_KEY=
LLM_PROFILE_DEFAULT_MODEL_LIGHT=
LLM_PROFILE_DEFAULT_MODEL_ANSWER=
LLM_PROFILE_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
WORKER_POLL_SEC=3
