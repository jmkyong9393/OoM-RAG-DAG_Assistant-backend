# ── Postgres (로컬 compose) ───────────────────────────────────────────────
POSTGRES_DB=oom
POSTGRES_USER=oom
POSTGRES_PASSWORD=oom
POSTGRES_PORT=5432

# ── Flyway placeholder (V2__roles.sql) ───────────────────────────────────
OOM_API_PASSWORD=oom_api
OOM_AI_PASSWORD=oom_ai

# ── api (Spring) ─────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/oom
DATABASE_URL=postgresql://oom:oom@localhost:5432/oom   # scripts/seed.py · Python 통합 테스트 픽스처(관리자)
DB_USER=oom            # 운영: oom_api
DB_PASSWORD=oom
FLYWAY_USER=oom        # 스키마 소유자(관리자)
FLYWAY_PASSWORD=oom
AI_BASE_URL=http://localhost:8000
AI_PORT=8000
CORS_ORIGINS=http://localhost:3000
SESSION_SAME_SITE=Lax          # 프론트가 다른 사이트(*.vercel.app 등)면 none 으로, 그때 SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
SEED_PASSWORD=Oom!demo-2026    # scripts/seed.py 가 시드 사용자 전원에 넣는 초기 비밀번호 (로컬 전용, 작성규칙 충족)
PORT=8080             # 호스트에서 포트가 겹치면 이 파일(deploy/.env, gitignore)에서만 바꾼다. 예: 15432/18080/18000

# ── ai (Python) — 키는 여기만 ────────────────────────────────────────────
AI_DB_URL=postgresql://oom_ai:oom_ai@localhost:5432/oom
AI_MODE=auto           # dummy | fake | openai | auto(키 있으면 openai, 없으면 fake)
LLM_PROFILE_DEFAULT_BASE_URL=https://api.openai.com/v1
LLM_PROFILE_DEFAULT_API_KEY=
LLM_PROFILE_DEFAULT_MODEL_LIGHT=
LLM_PROFILE_DEFAULT_MODEL_ANSWER=
LLM_PROFILE_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
WORKER_POLL_SEC=3
ANSWER_MAX_TOKENS=400  # 답변 생성 하드 상한(폭주 방지). 0 = 상한 없음. 분량은 프롬프트 지시(5문장 이내)가 1차로 조절

# ── 운영(docker-compose.prod.yml, 단일 호스트) ──
SITE_ADDRESS=            # Caddy 사이트 주소. 도메인(예: assist.example.com)이면 HTTPS 자동, 비우면 localhost(자체 서명)
SITE_ORIGIN=http://localhost   # CORS 허용 오리진 = 브라우저가 보는 주소(https://도메인)
SESSION_SECURE_COOKIE=true     # HTTPS 뒤에서는 true. localhost 평문 검증 때만 false
API_IMAGE=oom-api:local        # ghcr.io/<owner>/oom-api:<tag> — 비우면 ../api 를 로컬 빌드
AI_IMAGE=oom-ai:local          # ghcr.io/<owner>/oom-ai:<tag>
WEB_IMAGE=                     # 프론트 레포 Dockerfile 로 만든 이미지(필수) 예: ghcr.io/<owner>/oom-web:<tag>
